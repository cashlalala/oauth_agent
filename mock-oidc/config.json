{
  "interactiveLogin": true,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "a2a",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "a2a-client",
            "aud": ["a2a-agent"],
            "scope": "a2a.invoke"
          }
        },
        {
          "requestParam": "grant_type",
          "match": "authorization_code|refresh_token",
          "claims": {
            "sub": "${subject}",
            "aud": ["a2a-agent"],
            "scope": "a2a.invoke"
          }
        }
      ]
    }
  ]
}
