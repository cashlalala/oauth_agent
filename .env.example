# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# https://openrouter.ai/openrouter/free  -> the "free models router"
OPENROUTER_MODEL=openrouter/free

# A2A server
A2A_SERVER_HOST=127.0.0.1
A2A_SERVER_PORT=9999
# URL advertised in the agent card when behind a reverse proxy (default: http://HOST:PORT/)
# A2A_PUBLIC_URL=https://dev-auth.mediatek.inc/a2a

# OIDC auth for the agent (empty OIDC_ISSUER = no auth). With `docker compose up -d`:
# OIDC_ISSUER=http://localhost:8080/a2a
# OIDC_AUDIENCE=a2a-agent
# OIDC_SCOPE=a2a.invoke
# Client side (client CLI / demo.py):
# OIDC_CLIENT_ID=agent-client
# OIDC_CLIENT_SECRET=anything
# (or use --login for an interactive browser login as a user)

# Web UI (python -m a2a_demo.web)
# A2A_AGENT_URL=http://127.0.0.1:9999
# WEB_PORT=8000
# WEB_PUBLIC_URL=http://localhost:8000   # redirect URI = this + /auth/callback
# WEB_CLIENT_ID=a2a-web
