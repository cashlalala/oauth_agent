# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# https://openrouter.ai/openrouter/free  -> the "free models router"
OPENROUTER_MODEL=openrouter/free

# A2A server
A2A_SERVER_HOST=127.0.0.1
A2A_SERVER_PORT=9999

# OIDC auth for the agent (empty OIDC_ISSUER = no auth). With `docker compose up -d`:
# OIDC_ISSUER=http://localhost:8080/a2a
# OIDC_AUDIENCE=a2a-agent
# OIDC_SCOPE=a2a.invoke
# Client side (client CLI / demo.py):
# OIDC_CLIENT_ID=agent-client
# OIDC_CLIENT_SECRET=anything
